{
  "name": "ts-bedrock",
  "author": "Haniker",
  "version": "1.0.0",
  "license": "ISC",
  "description": "Monorepo for TypeFirst Bedrock Typescript project",
  "scripts": {
    "start": "bash ./devops/dev/start.sh",
    "tsc": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:strict": "oxlint --deny-warnings --type-aware",
    "external:start": "bash ./devops/external/start.sh",
    "db:migrate": "bash ./devops/external/db-migrate.sh",
    "db:seed": "bash ./devops/external/db-seed.sh",
    "db:rollback": "bash ./devops/external/db-rollback.sh",
    "db:migrate:create": "bash ./devops/external/db-migrate-create.sh",
    "test": "bash ./devops/test/run-test.sh",
    "test:watch": "bash ./devops/test/run-test.sh --watch",
    "staging:deploy:api": "TODO",
    "staging:deploy:web": "TODO: vite build",
    "production:deploy:api": "TODO",
    "production:deploy:web": "TODO"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "decoders": "^2.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.0",
    "kysely": "^0.28.3",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "contributes": {
    "snippets": [
      {
        "language": [
          "markdown"
        ],
        "path": "./.ai/snippets/prompts.json"
      }
    ]
  }
}
